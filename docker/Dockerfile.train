FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1 \
    RECO_HOME=/var/lib/reco

WORKDIR /app
COPY pyproject.toml README.md ./
COPY configs ./configs
COPY src ./src
RUN python -m pip install --no-cache-dir --use-feature=truststore '.[train]' \
    && groupadd --system reco \
    && useradd --system --gid reco --home-dir /nonexistent reco \
    && mkdir -p /var/lib/reco \
    && chown -R reco:reco /var/lib/reco

USER reco
CMD ["python", "-m", "reco", "run-all"]

